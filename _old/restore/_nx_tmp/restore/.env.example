# Deployment. Never commit a real key. Use a disposable testnet key.
DEPLOYER_PRIVATE_KEY=

# RPC
SEPOLIA_RPC_URL=https://rpc.sepolia.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
HOODI_RPC_URL=https://ethereum-hoodi-rpc.publicnode.com
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Explorer verification
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
POLYGONSCAN_API_KEY=

# CCIP / LayerZero adapter address on the target chain.
# Leave blank locally, deploy.js uses MockCrossChainRouter there.
CROSSCHAIN_ROUTER=
# Only for the operator-relayed testnet demo adapter. Not production transport.
TESTNET_DEMO_ROUTER=false

# Who can schedule timelock operations on a spoke. There is no Governor there,
# so without this the handoff would leave the timelock with no proposer and the
# whole spoke would be frozen. Use an ops multisig.
SPOKE_PROPOSER=

# Used by scripts/public-testnet-demo.js once both sides are deployed.
SOURCE_NETWORK=sepolia
DEST_NETWORK=hoodi

# Build. true downloads a native solc (faster). Leave false where
# binaries.soliditylang.org is blocked.
USE_NATIVE_SOLC=false
REPORT_GAS=false
